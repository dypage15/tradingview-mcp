{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "stream:dsrtl:5s": "node src/cli/index.js stream tables -f \"Dynamic Support\" -i 5000 -F",
    "stream:quote:5s": "node src/cli/index.js stream quote -i 5000",
    "test": "node --test tests/e2e.test.js tests/pine_analyze.test.js",
    "smoke": "node --test tests/cli.test.js tests/pine_analyze.test.js tests/quant-advisor-core.test.js tests/evaluate-nlf-grid-run.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:unit": "node --test tests/pine_analyze.test.js tests/cli.test.js tests/quant-advisor-core.test.js",
    "test:cli": "node --test tests/cli.test.js",
    "test:all": "node --test tests/e2e.test.js tests/pine_analyze.test.js tests/cli.test.js tests/quant-advisor-core.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/e2e.test.js tests/pine_analyze.test.js",
    "test:count": "node --test --test-reporter=spec tests/e2e.test.js 2>&1 | tail -5",
    "nlf:backtest-save": "node scripts/store-nlf-strategy-backtest.mjs",
    "nlf:grid-300": "node scripts/run-nlf-erl-grid-300.mjs",
    "nlf:eval-run": "node scripts/evaluate-nlf-grid-run.mjs",
    "clreg22:grid": "node scripts/run-clreg22-grid.mjs",
    "clreg22:eval": "node scripts/evaluate-clreg22-grid.mjs",
    "clreg22:deploy": "node scripts/redeploy-clreg22.mjs",
    "clreg22:export-log": "node scripts/export-clreg22-trade-log.mjs",
    "clreg22:apply-best": "node scripts/apply-clreg22-best.mjs",
    "clreg22:tf-sweep": "node scripts/run-clreg22-timeframe-sweep.mjs",
    "clreg23:deploy": "node scripts/redeploy-clreg22.mjs",
    "clreg23:refine": "node scripts/run-clreg22-refine-grid.mjs",
    "clreg23:session": "node scripts/run-clreg23-session-grid.mjs",
    "clreg23:oos": "node scripts/run-clreg23-oos-split.mjs",
    "clreg23:asia-ny": "node scripts/apply-clreg23-asia-ny.mjs",
    "clreg23:conf-split": "node scripts/run-clreg23-confluence-split.mjs",
    "clreg23:bb-grid": "node scripts/run-clreg23-bb-grid.mjs",
    "clreg23:bb-best": "node scripts/apply-clreg23-bb-best.mjs",
    "clreg23:rsi": "node scripts/apply-clreg23-rsi.mjs",
    "clreg23:cloud-only": "node scripts/apply-clreg23-cloud-only.mjs",
    "clreg23:off": "node scripts/apply-clreg23-off.mjs",
    "winrate-grid": "node scripts/winrate-grid.mjs",
    "optimize": "node scripts/winrate-grid.mjs",
    "grid:dd": "node scripts/run-grid-dd.mjs",
    "grid:secondary": "node scripts/secondary-sandbox-grid.mjs",
    "apply:secondary-grid": "node scripts/apply-secondary-grid-best.mjs",
    "grid:secondary-low-trades": "node scripts/secondary-pnl-low-trades-125.mjs",
    "grid:sweep-v22-low-trades": "node scripts/secondary-pnl-low-trades-125.mjs",
    "advisor": "node scripts/quant-advisor.mjs",
    "advisor:llm": "node scripts/quant-advisor.mjs --llm",
    "advisor:watch": "node scripts/quant-advisor.mjs --watch 300",
    "advisor:ui": "node scripts/advisor-ui.mjs",
    "dashboard": "node scripts/advisor-ui.mjs",
    "stack": "node scripts/launch-stack.mjs",
    "zalign:300": "node scripts/run-zalign-sweep-300.mjs",
    "fix:cbc-parse": "node scripts/fix-cbc-pine-parse.mjs",
    "grid:sev2-lite-300": "node scripts/run-sev2-strat-grid-300.mjs",
    "cbc:htf-grid": "node scripts/run-cbc-htf-zone-grid.mjs",
    "cbc:asia-v2-grid": "node scripts/run-cbc-htf-zone-grid.mjs",
    "cbc:asia-v2-verify": "node scripts/run-cbc-htf-zone-grid.mjs --profile smoke --verify",
    "cbc:asia-v2-smoke": "node scripts/run-cbc-htf-zone-grid.mjs --profile smoke",
    "cbc:asia-v2-levels-300": "node scripts/run-cbc-htf-zone-grid.mjs --profile levels300",
    "cbc:mnq-300": "node scripts/run-mnq-scenarios-300.mjs",
    "sec:ticks-entry-300": "node scripts/run-sec-ticks-scenarios-300.mjs",
    "sec:ticks-tp-300": "node scripts/run-sec-ticks-tp-targets-300.mjs",
    "sec:sweep-london-ib-800": "node scripts/run-sec-sweep-london-ib-800.mjs",
    "sec:sweep-learn-auto": "node scripts/run-sec-sweep-learn-autonomous.mjs",
    "sec:ticks-exits-300": "node scripts/run-sec-ticks-exits-300.mjs",
    "sec:ticks-exits-auto": "node scripts/run-sec-ticks-exits-autonomous.mjs",
    "sec:ticks-learn-auto": "node scripts/run-sec-ticks-learn-autonomous.mjs",
    "cbc:liquidity-pro-v5-300": "node scripts/run-cbc-liquidity-pro-v5-scenarios-300.mjs",
    "cbc:liquidity-pro-v6-300": "node scripts/run-cbc-liquidity-pro-v5-scenarios-300.mjs",
    "grid:cloud-rej": "node scripts/run-cloud-rejection-grid.mjs",
    "eval:erl-sync-tv": "node scripts/sync-erl-evaluator-to-tv.mjs",
    "push:pine": "node scripts/pine_push.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2"
  }
}
