// ══════════════════════════════════════════════════════════════════════════════
// 03 — BB CONFLUENCE
// Independent confluence indicator — Next Level Foundry
// ══════════════════════════════════════════════════════════════════════════════
// Outputs: band proximity state, band width state (expanding/contracting),
//          basis slope direction + magnitude, and a 0–3 quality score.
// Score logic:
//   3 = near band + bands contracting  (mean reversion setup, low volatility)
//   2 = near band + bands neutral
//   1 = near band + bands expanding    (volatility spike, lower reliability)
//   0 = away from band
// ══════════════════════════════════════════════════════════════════════════════

//@version=6
indicator("03 — BB Confluence", shorttitle="NLF BB", overlay=true, max_bars_back=500)


// ─── INPUTS ──────────────────────────────────────────────────────────────────

grp_bb = "═══ BOLLINGER BANDS ═══"
bbLen        = input.int(20, "BB Length", minval=1, group=grp_bb, tooltip="ChartArt default: 200. Standard: 20.")
bbMult       = input.float(2.0, "BB Std Dev", minval=0.5, step=0.1, group=grp_bb)
bbMode       = input.string("Proximity", "Entry Trigger", options=["Proximity", "Crossover"], group=grp_bb)
bbBufferMult = input.float(1.5, "Proximity Buffer (ATR mult)", minval=0.0, step=0.25, group=grp_bb, tooltip="Proximity mode only. 0 = hard band touch.")
bbAtrLen     = input.int(14, "ATR Length for buffer", minval=2, group=grp_bb, tooltip="Proximity mode only.")

grp_slope = "═══ SLOPE ═══"
slopeLen    = input.int(5, "Slope Lookback (bars)", minval=2, group=grp_slope)
steepThresh = input.float(0.15, "Steep Threshold (ATR-norm)", minval=0.01, step=0.01, group=grp_slope, tooltip="ATR-normalized basis slope. Above = steep. Below half = flat.")

grp_width = "═══ BAND WIDTH ═══"
widthLen = input.int(20, "Width Baseline Lookback", minval=5, group=grp_width, tooltip="SMA period used to define average BB width for expansion/contraction comparison")

grp_vis = "═══ CHARTART VISUALS ═══"
enableBBFill = input.bool(true, "BB Band Fill", group=grp_vis)
enableBarClr = input.bool(true, "Bar Color", group=grp_vis)
enableBgClr  = input.bool(true, "Background Color", group=grp_vis)

grp_panel = "═══ PANEL ═══"
showPanel = input.bool(true, "Show Panel", group=grp_panel)
panelPos  = input.string("Middle Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grp_panel)


// ─── BOLLINGER BANDS ─────────────────────────────────────────────────────────

source  = close
bbBasis = ta.sma(source, bbLen)
bbDev   = bbMult * ta.stdev(source, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

atrBuf      = ta.atr(bbAtrLen) * bbBufferMult
bbProxLong  = close <= bbLower + atrBuf
bbProxShort = close >= bbUpper - atrBuf

bbCrossLong  = ta.crossover(source, bbLower)
bbCrossShort = ta.crossunder(source, bbUpper)

bbCondLong  = bbMode == "Proximity" ? bbProxLong : bbCrossLong
bbCondShort = bbMode == "Proximity" ? bbProxShort : bbCrossShort
nearBand    = bbCondLong or bbCondShort


// ─── BAND WIDTH ANALYSIS ─────────────────────────────────────────────────────

bbWidth     = bbUpper - bbLower
bbWidthMean = ta.sma(bbWidth, widthLen)

isExpanding   = bbWidth > bbWidth[slopeLen] and bbWidth > bbWidthMean
isContracting = bbWidth < bbWidth[slopeLen] and bbWidth < bbWidthMean
widthNeutral  = not isExpanding and not isContracting

widthLabel = isExpanding ? "expanding" : isContracting ? "contracting" : "neutral"
widthClr   = isExpanding ? color.new(#ff3860, 0) : isContracting ? color.new(#06d6a0, 0) : color.new(#f59e0b, 0)


// ─── BASIS SLOPE ─────────────────────────────────────────────────────────────

atr14          = ta.atr(14)
basisSlopeRaw  = ta.linreg(bbBasis, slopeLen, 0) - ta.linreg(bbBasis, slopeLen, 1)
basisSlopeNorm = atr14 > 0 ? basisSlopeRaw / atr14 : 0.0
mildThresh     = steepThresh * 0.5

basisSlopeLabel = basisSlopeNorm > steepThresh ? "▲▲ steep" : basisSlopeNorm > mildThresh ? "▲  mild" : basisSlopeNorm < -steepThresh ? "▼▼ steep" : basisSlopeNorm < -mildThresh ? "▼  mild" : "──  flat"

slopeAgreesLong  = bbCondLong and basisSlopeNorm > 0
slopeAgreesShort = bbCondShort and basisSlopeNorm < 0
slopeAgrees      = slopeAgreesLong or slopeAgreesShort


// ─── QUALITY SCORE (0–3) ─────────────────────────────────────────────────────

bbScore = nearBand and isContracting ? 3 : nearBand and widthNeutral ? 2 : nearBand and isExpanding ? 1 : 0

qualLabel = bbScore == 3 ? "HIGH" : bbScore == 2 ? "MED" : bbScore == 1 ? "LOW" : "—"
qualClr   = bbScore == 3 ? color.new(#06d6a0, 0) : bbScore == 2 ? color.new(#f59e0b, 0) : bbScore == 1 ? color.new(#ff3860, 0) : color.new(#8b89a0, 0)

posVal = panelPos == "Top Left" ? position.top_left : panelPos == "Bottom Right" ? position.bottom_right : panelPos == "Bottom Left" ? position.bottom_left : panelPos == "Middle Right" ? position.middle_right : panelPos == "Middle Left" ? position.middle_left : position.top_right


// ─── CHARTART VISUALS ────────────────────────────────────────────────────────

caLong  = ta.crossover(source, bbLower) and bbBasis > bbBasis[1]
caShort = ta.crossunder(source, bbUpper) and bbBasis < bbBasis[1]

trendColor   = caLong ? color.green : caShort ? color.red : na
trendBgColor = caLong ? color.new(color.green, 50) : caShort ? color.new(color.red, 50) : na

barcolor(enableBarClr ? trendColor : na, title="ChartArt Bar Color")
bgcolor(enableBgClr ? trendBgColor : na, title="ChartArt BG Color")

bgcolor(bbCondLong ? color.new(#06d6a0, 93) : na, title="Near Lower BB")
bgcolor(bbCondShort ? color.new(#ff3860, 93) : na, title="Near Upper BB")


// ─── PLOTS ───────────────────────────────────────────────────────────────────

plot(bbBasis, "BB Basis", color=color.aqua, linewidth=1)
p_upper = plot(bbUpper, "BB Upper", color=color.silver, linewidth=1)
p_lower = plot(bbLower, "BB Lower", color=color.silver, linewidth=1)
fill(p_upper, p_lower, color=enableBBFill ? color.new(color.silver, 90) : na, title="BB Fill")


// ─── PANEL ───────────────────────────────────────────────────────────────────

var table bbPanel = table.new(posVal, 2, 8, bgcolor=color.new(#0a0a0f, 10), border_color=color.new(#a855f7, 70), border_width=1, frame_color=color.new(#a855f7, 50), frame_width=1)

if barstate.islast and showPanel
    table.cell(bbPanel, 0, 0, "BB CONFLUENCE", text_color=color.new(#a855f7, 0), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#12121e, 10))
    table.cell(bbPanel, 1, 0, "score  " + str.tostring(bbScore), text_color=qualClr, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(#12121e, 10))

    zoneText = bbCondLong ? "lower band" : bbCondShort ? "upper band" : "—"
    zoneClr  = bbCondLong ? color.new(#06d6a0, 0) : bbCondShort ? color.new(#ff3860, 0) : color.gray
    table.cell(bbPanel, 0, 1, "Zone", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 1, zoneText, text_color=zoneClr, text_size=size.tiny, text_halign=text.align_right)

    modeText = bbMode == "Proximity" ? "proximity" : "crossover"
    table.cell(bbPanel, 0, 2, "Mode", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 2, modeText, text_color=color.new(#e8e6f0, 0), text_size=size.tiny, text_halign=text.align_right)

    table.cell(bbPanel, 0, 3, "Band width", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 3, widthLabel, text_color=widthClr, text_size=size.tiny, text_halign=text.align_right)

    basisClr = basisSlopeNorm > 0 ? color.new(#06d6a0, 0) : basisSlopeNorm < 0 ? color.new(#ff3860, 0) : color.gray
    table.cell(bbPanel, 0, 4, "Basis slope", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 4, basisSlopeLabel, text_color=basisClr, text_size=size.tiny, text_halign=text.align_right)

    table.cell(bbPanel, 0, 5, "Slope norm", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 5, str.tostring(basisSlopeNorm, "#.###"), text_color=color.new(#e8e6f0, 0), text_size=size.tiny, text_halign=text.align_right)

    agreeText = nearBand ? (slopeAgrees ? "YES" : "NO") : "—"
    agreeClr  = nearBand ? (slopeAgrees ? color.new(#06d6a0, 0) : color.new(#ff3860, 0)) : color.gray
    table.cell(bbPanel, 0, 6, "Slope agrees", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 6, agreeText, text_color=agreeClr, text_size=size.tiny, text_halign=text.align_right)

    table.cell(bbPanel, 0, 7, "Quality", text_color=color.new(#8b89a0, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(bbPanel, 1, 7, qualLabel, text_color=qualClr, text_size=size.tiny, text_halign=text.align_right)
