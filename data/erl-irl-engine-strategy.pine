// ----------------------------------------------------------------------------
//  ERL → IRL LIQUIDITY ENGINE v2.2 — STRATEGY (full chart = indicator build)
//  Next Level Foundry
//
//  Tester uses the SAME visuals/math as indicator `ERL IRL Engine v2 [NLF]`:
//    ERL/IRL/PD lines, BwD box, flipped level, FVG boxes, advisor panel,
//    sweep/BwD/SR markers. Adds strategy orders below (continuation + reversal).
//
//  NOT financial advice.
// ----------------------------------------------------------------------------
//@version=6
strategy(
     title                   = "ERL IRL Engine v2 Strategy [NLF]",
     shorttitle              = "ERL-IRL",
     overlay                 = true,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     initial_capital         = 100000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.025,
     slippage                = 3,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 500,
     max_bars_back           = 5000,
     margin_long             = 100,
     margin_short            = 100)

// ----------------------------------------------------------------------------
//  INPUTS
// ----------------------------------------------------------------------------
gRange      = "RANGE DETECTION"
swingLen    = input.int(15,   "Swing Strength (bars each side)", minval = 3,  group = gRange)
maxLookback = input.int(300,  "Max Lookback (bars)",             minval = 50, group = gRange)

gPD         = "PREVIOUS DAY HIGH / LOW"
showPD      = input.bool(true, "Show PDH / PDL",       group = gPD)
pdLabel     = input.bool(true, "Show PDH/PDL Labels",  group = gPD)

gBwD        = "BREAK WITH DISPLACEMENT"
bwdATRMult  = input.float(1.2, "Min Body Size (x ATR)",    minval = 0.3, step = 0.1, group = gBwD)
bwdBodyPct  = input.int(55,    "Min Body % of Candle",     minval = 30,  maxval = 90, group = gBwD)
showBwDZone = input.bool(true, "Show Displacement Zone",   group = gBwD)
showFlipped = input.bool(true, "Show Flipped Level",       group = gBwD)
bwdZoneExt  = input.int(40,    "Extend Displacement Zone (bars)", minval = 5, group = gBwD)

gSweep      = "SWEEP LOGIC"
sweepCool   = input.int(20,  "Sweep Cooldown (bars)", minval = 0, group = gSweep)
sweepLock   = input.bool(true, "Lock Sweep to Level",   group = gSweep)

gFVG        = "IRL INEFFICIENCIES (FVG)"
fvgOn       = input.bool(true,  "Detect Inefficiencies",            group = gFVG)
fvgMinATR   = input.float(0.4,  "Min Size (x ATR)", minval = 0.1, step = 0.1, group = gFVG)
fvgMax      = input.int(8,      "Max Active FVGs",  minval = 1,    group = gFVG)

gSR         = "SR TREND CONFIRMATION"
srLen       = input.int(21,    "SR Lookback Length",       minval = 5, group = gSR)
showSR      = input.bool(false, "Show SR lines and zones", group = gSR)
showBarClr  = input.bool(true,  "SR candle colors",        group = gSR)

gSession    = "SESSION FILTER"
sessionOn   = input.bool(true,                "Apply Session Scoring", group = gSession)
sessionTZ   = input.string("America/New_York", "Chart Timezone",      group = gSession)

gStratNd    = "STRATEGY — Intraday (uses Chart Timezone above)"
entryOpenHm   = input.int(930,  "Earliest NEW entry (HHMM)",      minval = 0, maxval = 2359, group = gStratNd)
entryCutoffHm = input.int(1530, "Last NEW entry (HHMM)",          minval = 0, maxval = 2359, group = gStratNd)
nycFlatHm     = input.int(1600, "Flat all — session end (HHMM)", minval = 0, maxval = 2359, group = gStratNd)
// ~4h spacing on a 5m chart = enough separation for separate liquidity events; tighten for more granularity.
minBarsBetween = input.int(48, "Min bars between NEW entries",   minval = 0, maxval = 500, group = gStratNd)

gStratTrade = "STRATEGY — Entries"
tradeCont    = input.bool(true, "Allow continuation: BwD zone cross", group = gStratTrade)
tradeRevSr   = input.bool(true, "Allow reversal: SR aligns with bias", group = gStratTrade)
// Slightly below 75 HARD gate yields enough trades for Tester diagnostics — raise in Inputs for discretion.
minScoreCont = input.int(72, "Min confidence (continuation)", minval = 0, maxval = 100, group = gStratTrade)
minScoreRev  = input.int(72, "Min confidence (reversal SR)",    minval = 0, maxval = 100, group = gStratTrade)

gStratExit  = "STRATEGY — Exits"
slATRmult     = input.float(2.0, "Hard stop × ATR from entry",          minval = 0.2, step = 0.1, group = gStratExit)
useEngineTp   = input.bool(true, "TP at engine Draw Target px",           group = gStratExit)
atrTpFallback = input.float(3.0, "Fallback TP × ATR if target invalid", minval = 0.25, step = 0.25, group = gStratExit)
// Avoid micro-limits inside spread noise: capped limit must beat entry by ≥ this × ATR.
tpFloorATR  = input.float(1.15, "Min TP distance × ATR (long + / short −)", minval = 0.05, step = 0.05, group = gStratExit)
debugTpHint = input.bool(false, "Plot live TP hints when in trade", group = gStratExit)

gVis        = "VISUALS"
showERL     = input.bool(true, "Show ERL Levels",         group = gVis)
showIRL     = input.bool(true, "Show IRL Equilibrium",    group = gVis)
showFVGVis  = input.bool(true, "Show IRL Inefficiencies", group = gVis)
showMarkers = input.bool(true, "Show Event Markers",      group = gVis)
showPanel   = input.bool(true, "Show Advisor Panel",      group = gVis)
extR        = input.int(25,    "Extend Lines Right",      minval = 5, group = gVis)
showStratSig = input.bool(true, "Show strategy L/S cues",             group = gVis)
shadePos    = input.bool(true, "Background tint in position",         group = gVis)

gClr        = "COLORS"
cERLHi      = input.color(#f87171, "ERL High (BSL)",         group = gClr)
cERLLo      = input.color(#4ade80, "ERL Low (SSL)",          group = gClr)
cIRL        = input.color(#22d3ee, "IRL Equilibrium",        group = gClr)
cFVGClr     = input.color(#a855f7, "IRL Inefficiency (FVG)", group = gClr)
cPDH        = input.color(#fb923c, "PDH",                    group = gClr)
cPDL        = input.color(#facc15, "PDL",                    group = gClr)
cBwDBull    = input.color(#4ade80, "BwD Bullish Zone",       group = gClr)
cBwDBear    = input.color(#f87171, "BwD Bearish Zone",       group = gClr)
cFlipClr    = input.color(#c084fc, "Flipped Level",          group = gClr)
cSRRes      = input.color(#f472b6, "SR Resistance Zone",       group = gClr)
cSRSup      = input.color(#818cf8, "SR Support Zone",        group = gClr)

// NLF brand
cPurple     = #a855f7
cCyan       = #22d3ee
cBgDeep     = #07060b
cBgPanel    = #100e1a
cBgRow      = #15132a
cTextPri    = #e8e4f0
cTextMute   = #9f97b8
cAmber      = #facc15
cGreen      = #4ade80
cRed        = #f87171
cDim        = #3d3a52

// ----------------------------------------------------------------------------
//  HELPER — clamp bar references so drawings never exceed the historical buffer
// ----------------------------------------------------------------------------
safeBar(int b) =>
    math.max(b, bar_index - 4990)

minsFromHm(int hm) =>
    math.floor(hm / 100) * 60 + hm % 100

// ----------------------------------------------------------------------------
//  ATR + PRICE DATA
// ----------------------------------------------------------------------------
atr        = ta.atr(14)
bodySize   = math.abs(close - open)
candleRng  = high - low
bodyRatio  = candleRng > 0 ? bodySize / candleRng : 0.0

// ----------------------------------------------------------------------------
//  PDH / PDL
// ----------------------------------------------------------------------------
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)

var int dayStartBar = 0
if ta.change(time("D")) != 0
    dayStartBar := bar_index

// ----------------------------------------------------------------------------
//  SR TREND CONFIRMATION
// ----------------------------------------------------------------------------
srH    = bar_index > 5 and high[5] < high[4] and high[4] < high[3] and high[3] > high[2] and high[2] > high[1] ? 1 : 0
srL    = bar_index > 5 and low[5] > low[4] and low[4] > low[3] and low[3] < low[2] and low[2] < low[1] ? 1 : 0

srHn   = math.sum(srH, srLen)
srLn   = math.sum(srL, srLen)

srHval = srH > 0 ? high[3] : 0.0
srLval = srL > 0 ? low[3]  : 0.0

srHsum = math.sum(srHval, srLen)
srLsum = math.sum(srLval, srLen)

srR    = srLn > 0 and srHn > 0 ? math.abs(srHsum / srHn - srLsum / srLn) : 0.0

var float hvalc = na
var float lvalc = na
var float hvalr = na
var float lvalr = na

hvalc := srHval > 0 and srR > 0 ? srHval : hvalc[1]
lvalc := srLval > 0 and srR > 0 ? srLval : lvalc[1]
hvalr := srHval > 0 and srR > 0 ? srHval - srR : hvalr[1]
lvalr := srLval > 0 and srR > 0 ? srLval + srR : lvalr[1]

var int srTrend = 0
srTrend := close > lvalr and close > hvalr ? 1 : close < lvalr and close < hvalr ? -1 : srTrend[1]

srLongEntry  = srTrend == 1  and close > hvalc
srShortEntry = srTrend == -1 and close < lvalc

var int srLong  = 0
var int srShort = 0
srLong  := srTrend == 1  and close > hvalc ? 1 : srTrend == -1 ? -1 : srLong[1]
srShort := srTrend == -1 and close < lvalc ? 1 : srTrend == 1  ? -1 : srShort[1]

// ----------------------------------------------------------------------------
//  SWING RANGE — ERL HIGH / LOW
// ----------------------------------------------------------------------------
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow (swingLen, swingLen)

var array<float> phPx  = array.new<float>()
var array<int>   phBar = array.new<int>()
var array<float> plPx  = array.new<float>()
var array<int>   plBar = array.new<int>()

if not na(ph)
    array.push(phPx,  ph)
    array.push(phBar, bar_index - swingLen)
if not na(pl)
    array.push(plPx,  pl)
    array.push(plBar, bar_index - swingLen)

cutoff = bar_index - maxLookback
while array.size(phBar) > 0 and array.get(phBar, 0) < cutoff
    array.shift(phBar)
    array.shift(phPx)
while array.size(plBar) > 0 and array.get(plBar, 0) < cutoff
    array.shift(plBar)
    array.shift(plPx)

float rangeHi    = na
int   rangeHiBar = na
float rangeLo    = na
int   rangeLoBar = na

if array.size(phPx) > 0
    for i = 0 to array.size(phPx) - 1
        v = array.get(phPx, i)
        if na(rangeHi) or v > rangeHi
            rangeHi    := v
            rangeHiBar := array.get(phBar, i)

if array.size(plPx) > 0
    for i = 0 to array.size(plPx) - 1
        v = array.get(plPx, i)
        if na(rangeLo) or v < rangeLo
            rangeLo    := v
            rangeLoBar := array.get(plBar, i)

eq = na(rangeHi) or na(rangeLo) ? na : (rangeHi + rangeLo) / 2.0

// ----------------------------------------------------------------------------
//  SESSION SCORING (+ strategy clock in same TZ)
// ----------------------------------------------------------------------------
hh      = hour(time,   sessionTZ)
mm      = minute(time, sessionTZ)
tVal    = hh * 100 + mm
inLon   = tVal >= 300  and tVal < 1200
inNY    = tVal >= 930  and tVal < 1600
inSess  = inLon or inNY

mnNow      = hh * 60 + mm
mnEnterO   = minsFromHm(entryOpenHm)
mnEnterX   = minsFromHm(entryCutoffHm)
mnFlatNY   = minsFromHm(nycFlatHm)
nyEntryWin = mnNow >= mnEnterO and mnNow < mnEnterX
nyPastClose = mnNow >= mnFlatNY

// ----------------------------------------------------------------------------
//  SWEEP DETECTION
// ----------------------------------------------------------------------------
var string lastSweepType = "NONE"
var int    lastSweepBar  = na
var float  bslSweptLvl   = na
var float  sslSweptLvl   = na
var int    lastBSLBar    = na
var int    lastSSLBar    = na

bslERL  = not na(rangeHi) and high > rangeHi and close < rangeHi
sslERL  = not na(rangeLo) and low  < rangeLo and close > rangeLo
bslPDH  = not na(pdh) and high > pdh and close < pdh
sslPDL  = not na(pdl) and low  < pdl and close > pdl

bslNewLvl = not sweepLock or na(bslSweptLvl) or (rangeHi != bslSweptLvl and pdh != bslSweptLvl)
sslNewLvl = not sweepLock or na(sslSweptLvl) or (rangeLo != sslSweptLvl and pdl != sslSweptLvl)
bslCool   = na(lastBSLBar) or bar_index - lastBSLBar >= sweepCool
sslCool   = na(lastSSLBar) or bar_index - lastSSLBar >= sweepCool

bslSweep  = (bslERL or bslPDH) and bslNewLvl and bslCool
sslSweep  = (sslERL or sslPDL) and sslNewLvl and sslCool

if bslSweep
    lastSweepType := "BSL"
    lastSweepBar  := bar_index
    bslSweptLvl   := bslPDH ? pdh : rangeHi
    lastBSLBar    := bar_index
if sslSweep
    lastSweepType := "SSL"
    lastSweepBar  := bar_index
    sslSweptLvl   := sslPDL ? pdl : rangeLo
    lastSSLBar    := bar_index

// ----------------------------------------------------------------------------
//  BREAK WITH DISPLACEMENT
// ----------------------------------------------------------------------------
bwdSizeOK = bodySize >= atr * bwdATRMult
bwdBodyOK = bodyRatio >= bwdBodyPct / 100.0

bullBwD_ERL = not na(rangeHi) and close > rangeHi and open <= rangeHi and bwdSizeOK and bwdBodyOK
bearBwD_ERL = not na(rangeLo) and close < rangeLo and open >= rangeLo and bwdSizeOK and bwdBodyOK
bullBwD_PDH = not na(pdh) and close > pdh and open <= pdh and bwdSizeOK and bwdBodyOK
bearBwD_PDL = not na(pdl) and close < pdl and open >= pdl and bwdSizeOK and bwdBodyOK

bullBwD = (bullBwD_ERL or bullBwD_PDH) and not bearBwD_ERL and not bearBwD_PDL
bearBwD = (bearBwD_ERL or bearBwD_PDL) and not bullBwD_ERL and not bullBwD_PDH

var string lastBwDType  = "NONE"
var int    lastBwDBar   = na
var float  bwdZoneTop   = na
var float  bwdZoneBot   = na
var float  flippedLvl   = na
var bool   flippedBull  = false
var float  extensionHi  = na
var float  extensionLo  = na

if bullBwD
    lastBwDType  := "BULL"
    lastBwDBar   := bar_index
    bwdZoneTop   := math.max(open, close)
    bwdZoneBot   := math.min(open, close)
    flippedLvl   := bullBwD_PDH ? pdh : rangeHi
    flippedBull  := true
    extensionHi  := high
    extensionLo  := na
    bslSweptLvl  := bullBwD_PDH ? pdh : rangeHi
    lastBSLBar   := bar_index

if bearBwD
    lastBwDType  := "BEAR"
    lastBwDBar   := bar_index
    bwdZoneTop   := math.max(open, close)
    bwdZoneBot   := math.min(open, close)
    flippedLvl   := bearBwD_PDL ? pdl : rangeLo
    flippedBull  := false
    extensionLo  := low
    extensionHi  := na
    sslSweptLvl  := bearBwD_PDL ? pdl : rangeLo
    lastSSLBar   := bar_index

if lastBwDType == "BULL" and not na(extensionHi)
    extensionHi := math.max(extensionHi, high)
if lastBwDType == "BEAR" and not na(extensionLo)
    extensionLo := math.min(extensionLo, low)

inBwDZone = lastBwDType != "NONE" and not na(bwdZoneTop) and not na(lastBwDBar) and bar_index > lastBwDBar and high >= bwdZoneBot and low <= bwdZoneTop

if not na(flippedLvl) and not na(lastBwDBar)
    barsSinceFlip = bar_index - lastBwDBar
    farFromFlip   = math.abs(close - flippedLvl) > atr * 10
    if (barsSinceFlip > 200 and not inBwDZone) or farFromFlip
        flippedLvl  := na
        flippedBull := false

// ----------------------------------------------------------------------------
//  MODE + BIAS
// ----------------------------------------------------------------------------
barsSweep = na(lastSweepBar) ? 99999 : bar_index - lastSweepBar
barsBwD   = na(lastBwDBar)   ? 99999 : bar_index - lastBwDBar

string mode = "WAIT"
string bias = "NEUTRAL"

if lastSweepType == "NONE" and lastBwDType == "NONE"
    mode := "WAIT"
    bias := "NEUTRAL"
else if barsSweep <= barsBwD and lastSweepType != "NONE"
    if lastSweepType == "BSL"
        mode := "REVERSAL"
        bias := "SHORT"
    else if lastSweepType == "SSL"
        mode := "REVERSAL"
        bias := "LONG"
else if lastBwDType != "NONE"
    if lastBwDType == "BULL"
        mode := "CONTINUATION"
        bias := "LONG"
    else if lastBwDType == "BEAR"
        mode := "CONTINUATION"
        bias := "SHORT"

aboveEq = not na(eq) and close > eq
belowEq = not na(eq) and close <= eq

string drawTarget   = "---"
float  drawTargetPx = na

if mode == "REVERSAL"
    if bias == "SHORT"
        drawTarget   := aboveEq ? "IRL Equilibrium 50%" : "ERL Low SSL Pool"
        drawTargetPx := aboveEq ? eq : rangeLo
    else
        drawTarget   := belowEq ? "IRL Equilibrium 50%" : "ERL High BSL Pool"
        drawTargetPx := belowEq ? eq : rangeHi
else if mode == "CONTINUATION"
    if inBwDZone
        drawTarget   := "Displacement Zone Entry"
        drawTargetPx := (bwdZoneTop + bwdZoneBot) / 2.0
    else if bias == "LONG"
        drawTarget   := "Extension High New BSL"
        drawTargetPx := extensionHi
    else
        drawTarget   := "Extension Low New SSL"
        drawTargetPx := extensionLo

// ----------------------------------------------------------------------------
//  CONFIDENCE SCORE
// ----------------------------------------------------------------------------
int score = 0

if mode == "REVERSAL" and lastSweepType != "NONE"
    score += 35
if mode == "CONTINUATION" and lastBwDType != "NONE"
    score += 35

if not na(pdh) and not na(pdl) and mode != "WAIT"
    eventLvl = mode == "REVERSAL" ? (lastSweepType == "BSL" ? bslSweptLvl : sslSweptLvl) : (lastBwDType == "BULL" ? bwdZoneTop : bwdZoneBot)
    keyLvl   = mode == "REVERSAL" ? (lastSweepType == "BSL" ? pdh : pdl) : (lastBwDType == "BULL" ? pdh : pdl)
    if not na(eventLvl) and not na(keyLvl) and math.abs(eventLvl - keyLvl) < atr * 1.5
        score += 15

if sessionOn
    score += inSess ? 20 : -10

if srTrend == 1 and bias == "LONG"
    score += 15
else if srTrend == -1 and bias == "SHORT"
    score += 15
else if (srTrend == 1 and bias == "SHORT") or (srTrend == -1 and bias == "LONG")
    score -= 10

if mode == "CONTINUATION" and inBwDZone
    score += 20

freshBars = mode == "REVERSAL" ? barsSweep : barsBwD
score += freshBars < 20 ? 20 : freshBars < 50 ? 12 : freshBars < 100 ? 6 : 0

if not na(rangeHi) and not na(rangeLo)
    score += 10

score := math.max(0, math.min(score, 100))

// -----------------------------------------------------------------------------
// Alerts + strategy cues (definitions before Tester orders / alertcondition)
// -----------------------------------------------------------------------------
bwdZoneEntry  = mode == "CONTINUATION" and inBwDZone and not inBwDZone[1]
highScoreEdge = score >= 75 and not (score[1] >= 75)
// SR alignment rarity tracks the looser entry score gate so reversals stay consistent with inputs.
alignScoreThr = math.min(minScoreCont, minScoreRev)
srLongAlign   = srLongEntry and not srLongEntry[1] and bias == "LONG" and score >= alignScoreThr
srShortAlign  = srShortEntry and not srShortEntry[1] and bias == "SHORT" and score >= alignScoreThr

longCont  = tradeCont and mode == "CONTINUATION" and bias == "LONG" and bwdZoneEntry and score >= minScoreCont
shortCont = tradeCont and mode == "CONTINUATION" and bias == "SHORT" and bwdZoneEntry and score >= minScoreCont
longRev   = tradeRevSr and mode == "REVERSAL" and bias == "LONG" and srLongAlign and score >= minScoreRev
shortRev  = tradeRevSr and mode == "REVERSAL" and bias == "SHORT" and srShortAlign and score >= minScoreRev

longRaw  = longCont or longRev
shortRaw = shortCont or shortRev

var int lastEntryBi = na
enteredBar = strategy.position_size != 0 and strategy.position_size[1] == 0
if enteredBar
    lastEntryBi := bar_index

betweenOk = minBarsBetween <= 0 or na(lastEntryBi) or bar_index - lastEntryBi >= minBarsBetween

longSig  = longRaw and nyEntryWin and betweenOk
shortSig = shortRaw and nyEntryWin and betweenOk

if longSig and strategy.position_size < 0
    strategy.close("S", comment = "cover short -> long setup")
if shortSig and strategy.position_size > 0
    strategy.close("L", comment = "sell long -> short setup")

if strategy.position_size == 0 and longSig and not shortSig
    strategy.entry("L", strategy.long)

if strategy.position_size == 0 and shortSig and not longSig
    strategy.entry("S", strategy.short)

avgAll = strategy.position_avg_price

stpLongRaw  = avgAll - atr * slATRmult
stpShortRaw = avgAll + atr * slATRmult

tpLngRaw = strategy.position_size > 0 ? (useEngineTp and not na(drawTargetPx) and drawTargetPx > avgAll ? drawTargetPx : avgAll + atr * atrTpFallback) : na
tpShRaw = strategy.position_size < 0 ? (useEngineTp and not na(drawTargetPx) and drawTargetPx < avgAll ? drawTargetPx : avgAll - atr * atrTpFallback) : na
tpLng = strategy.position_size > 0 and not na(tpLngRaw) ? math.max(tpLngRaw, avgAll + atr * tpFloorATR) : na
tpSh = strategy.position_size < 0 and not na(tpShRaw) ? math.min(tpShRaw, avgAll - atr * tpFloorATR) : na

if strategy.position_size > 0 and not na(tpLng)
    strategy.exit("XL", from_entry = "L", limit = tpLng, stop = stpLongRaw)

if strategy.position_size < 0 and not na(tpSh)
    strategy.exit("XS", from_entry = "S", limit = tpSh, stop = stpShortRaw)

if barstate.isconfirmed and nyPastClose
    strategy.cancel_all()
    strategy.close_all(comment = "Session end flat")

// ----------------------------------------------------------------------------
//  FVG — IRL INEFFICIENCIES
// ----------------------------------------------------------------------------
type FVG
    float top
    float bot
    int   barIdx
    bool  bullish
    bool  mitigated
    box   bx
    label lbl

var array<FVG> fvgs = array.new<FVG>()

if fvgOn and barstate.isconfirmed
    bullGap = low > high[2] and (low - high[2]) > atr * fvgMinATR
    bearGap = high < low[2] and (low[2] - high) > atr * fvgMinATR
    if bullGap
        array.push(fvgs, FVG.new(low, high[2], bar_index, true, false, na, na))
    if bearGap
        array.push(fvgs, FVG.new(low[2], high, bar_index, false, false, na, na))

// mitigation check
if array.size(fvgs) > 0
    for i = 0 to array.size(fvgs) - 1
        f = array.get(fvgs, i)
        if not f.mitigated
            if f.bullish and low <= f.bot
                f.mitigated := true
            if not f.bullish and high >= f.top
                f.mitigated := true

// prune mitigated and stale FVGs (older than maxLookback bars)
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        isStale = (bar_index - f.barIdx) > maxLookback
        if f.mitigated or isStale
            if not na(f.bx)
                box.delete(f.bx)
            if not na(f.lbl)
                label.delete(f.lbl)
            array.remove(fvgs, i)

// cap count
while array.size(fvgs) > fvgMax
    old = array.shift(fvgs)
    if not na(old.bx)
        box.delete(old.bx)
    if not na(old.lbl)
        label.delete(old.lbl)

// ----------------------------------------------------------------------------
//  DRAW — ERL / IRL LINES
// ----------------------------------------------------------------------------
var line  lnHi = na
var line  lnLo = na
var line  lnEq = na
var label lbHi = na
var label lbLo = na
var label lbEq = na

if barstate.islast
    line.delete(lnHi)
    line.delete(lnLo)
    line.delete(lnEq)
    label.delete(lbHi)
    label.delete(lbLo)
    label.delete(lbEq)

    if showERL and not na(rangeHi) and not na(rangeHiBar)
        lnHi := line.new(safeBar(rangeHiBar), rangeHi, bar_index + extR, rangeHi, color = cERLHi, width = 2)
        lbHi := label.new(bar_index + extR, rangeHi, "ERL HIGH  BSL  " + str.tostring(rangeHi, format.mintick), color = color.new(cERLHi, 85), textcolor = cERLHi, style = label.style_label_left, size = size.small)

    if showERL and not na(rangeLo) and not na(rangeLoBar)
        lnLo := line.new(safeBar(rangeLoBar), rangeLo, bar_index + extR, rangeLo, color = cERLLo, width = 2)
        lbLo := label.new(bar_index + extR, rangeLo, "ERL LOW  SSL  " + str.tostring(rangeLo, format.mintick), color = color.new(cERLLo, 85), textcolor = cERLLo, style = label.style_label_left, size = size.small)

    if showIRL and not na(eq) and not na(rangeHiBar) and not na(rangeLoBar)
        eqStart = safeBar(math.min(rangeHiBar, rangeLoBar))
        lnEq := line.new(eqStart, eq, bar_index + extR, eq, color = cIRL, width = 1, style = line.style_dashed)
        lbEq := label.new(bar_index + extR, eq, "IRL  EQ 50%  " + str.tostring(eq, format.mintick), color = color.new(cIRL, 85), textcolor = cIRL, style = label.style_label_left, size = size.small)

// ----------------------------------------------------------------------------
//  DRAW — PDH / PDL
// ----------------------------------------------------------------------------
var line  lnPDH = na
var line  lnPDL = na
var label lbPDH = na
var label lbPDL = na

if showPD and barstate.islast
    line.delete(lnPDH)
    line.delete(lnPDL)
    label.delete(lbPDH)
    label.delete(lbPDL)

    if not na(pdh)
        lnPDH := line.new(safeBar(dayStartBar), pdh, bar_index + extR, pdh, color = cPDH, width = 1, style = line.style_dotted)
        if pdLabel
            lbPDH := label.new(bar_index + extR, pdh, "PDH  " + str.tostring(pdh, format.mintick), color = color.new(cPDH, 85), textcolor = cPDH, style = label.style_label_left, size = size.small)

    if not na(pdl)
        lnPDL := line.new(safeBar(dayStartBar), pdl, bar_index + extR, pdl, color = cPDL, width = 1, style = line.style_dotted)
        if pdLabel
            lbPDL := label.new(bar_index + extR, pdl, "PDL  " + str.tostring(pdl, format.mintick), color = color.new(cPDL, 85), textcolor = cPDL, style = label.style_label_left, size = size.small)

// ----------------------------------------------------------------------------
//  DRAW — BwD DISPLACEMENT ZONE
// ----------------------------------------------------------------------------
var box   bwdBox = na
var label bwdLbl = na

if showBwDZone
    if bullBwD or bearBwD
        box.delete(bwdBox)
        label.delete(bwdLbl)
        zClr   = bullBwD ? cBwDBull : cBwDBear
        zDir   = bullBwD ? "BULL BwD" : "BEAR BwD"
        zStyle = bullBwD ? label.style_label_lower_right : label.style_label_upper_right
        bwdBox := box.new(bar_index, bwdZoneTop, bar_index + bwdZoneExt, bwdZoneBot, border_color = color.new(zClr, 20), bgcolor = color.new(zClr, 78), border_width = 2)
        bwdLbl := label.new(bar_index, bullBwD ? bwdZoneTop : bwdZoneBot, "BwD  " + zDir + "  RETRACE ENTRY", color = color.new(zClr, 75), textcolor = zClr, style = zStyle, size = size.small)
    else if not na(bwdBox)
        box.set_right(bwdBox, bar_index + bwdZoneExt)

// ----------------------------------------------------------------------------
//  DRAW — FLIPPED LEVEL
// ----------------------------------------------------------------------------
var line  lnFlip = na
var label lbFlip = na

if showFlipped and barstate.islast
    line.delete(lnFlip)
    label.delete(lbFlip)
    if not na(flippedLvl) and not na(lastBwDBar)
        flipRole = flippedBull ? "NOW SUPPORT" : "NOW RESISTANCE"
        lnFlip := line.new(safeBar(lastBwDBar), flippedLvl, bar_index + extR + 15, flippedLvl, color = cFlipClr, width = 1, style = line.style_dashed)
        lbFlip := label.new(bar_index + extR + 15, flippedLvl, "FLIPPED  " + flipRole + "  " + str.tostring(flippedLvl, format.mintick), color = color.new(cFlipClr, 82), textcolor = cFlipClr, style = label.style_label_left, size = size.tiny)

// ----------------------------------------------------------------------------
//  DRAW — FVG BOXES
// ----------------------------------------------------------------------------
if showFVGVis and array.size(fvgs) > 0
    for i = 0 to array.size(fvgs) - 1
        f = array.get(fvgs, i)
        if na(f.bx)
            f.bx  := box.new(safeBar(f.barIdx - 1), f.top, bar_index + 5, f.bot, border_color = color.new(cFVGClr, 40), bgcolor = color.new(cFVGClr, 82), border_width = 1)
            f.lbl := label.new(safeBar(f.barIdx), f.bullish ? f.top : f.bot, "IRL FVG", color = color.new(cFVGClr, 80), textcolor = cFVGClr, style = label.style_label_right, size = size.tiny)
        else
            box.set_right(f.bx, bar_index + 5)

// ----------------------------------------------------------------------------
//  SR — optional level plots + fills
// ----------------------------------------------------------------------------
srResC = plot(showSR ? hvalc : na, "SR Resistance",          color = color.new(cSRRes, 20), linewidth = 1)
srSupC = plot(showSR ? lvalc : na, "SR Support",             color = color.new(cSRSup, 20), linewidth = 1)
srResX = plot(showSR ? hvalr : na, "SR Resistance Extended", color = color.new(cSRRes, 55), linewidth = 1, style = plot.style_linebr)
srSupX = plot(showSR ? lvalr : na, "SR Support Extended",    color = color.new(cSRSup, 55), linewidth = 1, style = plot.style_linebr)

fill(srResC, srResX, title = "SR Resistance Zone", color = showSR ? color.new(cSRRes, 88) : na)
fill(srSupC, srSupX, title = "SR Support Zone",    color = showSR ? color.new(cSRSup, 88) : na)

plot(debugTpHint and strategy.position_size > 0 ? tpLng : na, "Live long TP hint", color = color.new(#22d3ee, 0), linewidth = 2)
plot(debugTpHint and strategy.position_size < 0 ? tpSh : na, "Live short TP hint", color = color.new(#fb923c, 0), linewidth = 2)

plotshape(showMarkers and srLongEntry and not srLongEntry[1], title = "SR Long Entry", style = shape.circle, location = location.belowbar, color = cSRSup, size = size.tiny, text = "SR")
plotshape(showMarkers and srShortEntry and not srShortEntry[1], title = "SR Short Entry", style = shape.circle, location = location.abovebar, color = cSRRes, size = size.tiny, text = "SR")

srCandleClr = srLong > 0 ? color.new(cSRSup, 25) : srShort > 0 ? color.new(cSRRes, 25) : srTrend > 0 ? color.new(cSRSup, 70) : srTrend < 0 ? color.new(cSRRes, 70) : na
barcolor(showBarClr ? srCandleClr : na)

posBgClr = shadePos and strategy.position_size > 0 ? color.new(#4ade80, 93) : shadePos and strategy.position_size < 0 ? color.new(#f87171, 93) : na
bgcolor(posBgClr)

// ----------------------------------------------------------------------------
//  CHART MARKERS
// ----------------------------------------------------------------------------
plotshape(showMarkers and bslSweep, title = "BSL Swept", style = shape.triangledown, location = location.abovebar,
     color = cERLHi, size = size.small, text = "BSL SWEPT")

plotshape(showMarkers and sslSweep, title = "SSL Swept", style = shape.triangleup, location = location.belowbar,
     color = cERLLo, size = size.small, text = "SSL SWEPT")

plotshape(showMarkers and bullBwD, title = "Bull BwD", style = shape.arrowup, location = location.belowbar,
     color = cBwDBull, size = size.normal, text = "BwD")

plotshape(showMarkers and bearBwD, title = "Bear BwD", style = shape.arrowdown, location = location.abovebar,
     color = cBwDBear, size = size.normal, text = "BwD")

plotshape(showStratSig and longSig and strategy.position_size == 0, title = "Strat LONG", style = shape.triangleup,
     location = location.belowbar, color = color.teal, size = size.small, text = "L")

plotshape(showStratSig and shortSig and strategy.position_size == 0, title = "Strat SHORT", style = shape.triangledown,
     location = location.abovebar, color = color.maroon, size = size.small, text = "S")

// ----------------------------------------------------------------------------
//  ADVISOR PANEL
// ----------------------------------------------------------------------------
if showPanel and barstate.islast
    var table tbl = table.new(position.top_right, 2, 17, bgcolor = cBgDeep, border_color = cPurple, border_width = 1, frame_color = cPurple, frame_width = 2)

    table.cell(tbl, 0, 0, "  ERL IRL ENGINE v2.2  ", text_color = cCyan, text_size = size.normal, bgcolor = color.new(cPurple, 60))
    table.merge_cells(tbl, 0, 0, 1, 0)

    modeClr = mode == "REVERSAL" ? cAmber : mode == "CONTINUATION" ? cCyan : cDim
    table.cell(tbl, 0, 1, "  MODE", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 1, mode + "  ", text_color = modeClr, text_size = size.normal, text_halign = text.align_right, bgcolor = cBgPanel)

    biasClr = bias == "LONG" ? cGreen : bias == "SHORT" ? cRed : cDim
    table.cell(tbl, 0, 2, "  BIAS", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 2, bias + "  ", text_color = biasClr, text_size = size.normal, text_halign = text.align_right, bgcolor = cBgRow)

    evtStr = mode == "REVERSAL" ? (lastSweepType == "BSL" ? "BSL Raided" : "SSL Raided") : mode == "CONTINUATION" ? (lastBwDType == "BULL" ? "Bull BwD" : "Bear BwD") : "None"
    evtClr = mode == "REVERSAL" ? cAmber : cCyan
    table.cell(tbl, 0, 3, "  LAST EVENT", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 3, evtStr + "  ", text_color = evtClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgPanel)

    pdCtx = not na(pdh) and not na(pdl) ? (close > pdh ? "Above PDH" : close < pdl ? "Below PDL" : "Inside Range") : "---"
    pdCtxClr = not na(pdh) and close > pdh ? cGreen : not na(pdl) and close < pdl ? cRed : cAmber
    table.cell(tbl, 0, 4, "  PDH / PDL", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 4, pdCtx + "  ", text_color = pdCtxClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgRow)

    bwdStat = mode == "CONTINUATION" ? (inBwDZone ? "IN ZONE" : "Waiting Retrace") : "---"
    bwdStatClr = inBwDZone ? cGreen : cTextMute
    table.cell(tbl, 0, 5, "  BwD ZONE", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 5, bwdStat + "  ", text_color = bwdStatClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgPanel)

    flipStr = not na(flippedLvl) ? str.tostring(flippedLvl, format.mintick) + (flippedBull ? " (Sup)" : " (Res)") : "---"
    table.cell(tbl, 0, 6, "  FLIPPED LVL", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 6, flipStr + "  ", text_color = cFlipClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgRow)

    table.cell(tbl, 0, 7, "  DRAW TARGET", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 7, drawTarget + "  ", text_color = cCyan, text_size = size.small, text_halign = text.align_right, bgcolor = cBgPanel)

    tgtStr  = na(drawTargetPx) ? "---" : str.tostring(drawTargetPx, format.mintick)
    dist    = na(drawTargetPx) ? na : math.abs(close - drawTargetPx)
    distStr = na(dist) ? "---" : str.tostring(dist, format.mintick) + " pts"
    table.cell(tbl, 0, 8, "  TARGET PRICE", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 8, tgtStr + "  ", text_color = cCyan, text_size = size.small, text_halign = text.align_right, bgcolor = cBgRow)
    table.cell(tbl, 0, 9, "  DISTANCE", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 9, distStr + "  ", text_color = cTextPri, text_size = size.small, text_halign = text.align_right, bgcolor = cBgPanel)

    sessStr = inSess ? (inLon and inNY ? "London + NY" : inLon ? "London" : "New York") : "Off-Session"
    sessClr = inSess ? cGreen : cDim
    table.cell(tbl, 0, 10, "  SESSION", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 10, sessStr + "  ", text_color = sessClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgRow)

    scoreClr = score >= 75 ? cGreen : score >= 50 ? cAmber : cRed
    table.cell(tbl, 0, 11, "  CONFIDENCE", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 11, str.tostring(score) + " / 100  ", text_color = scoreClr, text_size = size.normal, text_halign = text.align_right, bgcolor = cBgPanel)

    string action = "WAIT"
    color  actClr = cDim
    if score >= 75
        if mode == "REVERSAL"
            action := bias == "LONG" ? "HUNT LONGS Reversal" : "HUNT SHORTS Reversal"
            actClr := bias == "LONG" ? cGreen : cRed
        else if mode == "CONTINUATION"
            if inBwDZone
                action := bias == "LONG" ? "ENTER LONG BwD Zone" : "ENTER SHORT BwD Zone"
                actClr := bias == "LONG" ? cGreen : cRed
            else
                action := "WAIT FOR RETRACE"
                actClr := cAmber
    else if score >= 50
        action := "MONITOR Setup Building"
        actClr := cAmber

    table.cell(tbl, 0, 12, "  ACTION", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 12, action + "  ", text_color = actClr, text_size = size.normal, text_halign = text.align_right, bgcolor = cBgRow)

    srTrendStr = srTrend == 1 ? "BULL" : srTrend == -1 ? "BEAR" : "NEUTRAL"
    srTrendClr = srTrend == 1 ? cGreen : srTrend == -1 ? cRed : cDim
    srAgrees   = (srTrend == 1 and bias == "LONG") or (srTrend == -1 and bias == "SHORT")
    srConflict = (srTrend == 1 and bias == "SHORT") or (srTrend == -1 and bias == "LONG")
    srTag      = srAgrees ? " OK" : srConflict ? " X" : ""
    table.cell(tbl, 0, 13, "  SR TREND", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 13, srTrendStr + srTag + "  ", text_color = srTrendClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgPanel)

    srEntryStr = srLongEntry ? "LONG READY" : srShortEntry ? "SHORT READY" : "---"
    srEntryClr = srLongEntry ? cGreen : srShortEntry ? cRed : cDim
    table.cell(tbl, 0, 14, "  SR ENTRY", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgRow)
    table.cell(tbl, 1, 14, srEntryStr + "  ", text_color = srEntryClr, text_size = size.small, text_halign = text.align_right, bgcolor = cBgRow)

    rngSz  = na(rangeHi) or na(rangeLo) ? na : rangeHi - rangeLo
    rngStr = na(rngSz) ? "Detecting" : str.tostring(rngSz, format.mintick) + " pts"
    table.cell(tbl, 0, 15, "  RANGE", text_color = cTextMute, text_size = size.small, text_halign = text.align_left, bgcolor = cBgPanel)
    table.cell(tbl, 1, 15, rngStr + "  ", text_color = cTextPri, text_size = size.small, text_halign = text.align_right, bgcolor = cBgPanel)

    table.cell(tbl, 0, 16, "NLF // LIQUIDITY ENGINE v2.2", text_color = cPurple, text_size = size.tiny, bgcolor = cBgDeep)
    table.merge_cells(tbl, 0, 16, 1, 16)

// ----------------------------------------------------------------------------
//  ALERTS
// ----------------------------------------------------------------------------
alertcondition(bslSweep, "BSL Swept", "Buy-side stops taken. Mode REVERSAL SHORT. Draw to IRL.")
alertcondition(sslSweep, "SSL Swept", "Sell-side stops taken. Mode REVERSAL LONG. Draw to IRL.")
alertcondition(bullBwD, "Bullish BwD", "Bullish displacement confirmed. Mode CONTINUATION LONG. Wait for retrace.")
alertcondition(bearBwD, "Bearish BwD", "Bearish displacement confirmed. Mode CONTINUATION SHORT. Wait for retrace.")
alertcondition(bwdZoneEntry, "BwD Retrace Entry", "Price entered BwD displacement zone. Continuation entry active.")
alertcondition(highScoreEdge, "High Confidence 75+", "Confidence crossed 75. Review chart for entry.")

alertcondition(srLongAlign, "SR + ERL/IRL Long", "SR long entry + ERL/IRL LONG bias confirmed.")
alertcondition(srShortAlign, "SR + ERL/IRL Short", "SR short entry + ERL/IRL SHORT bias confirmed.")
