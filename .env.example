# Full stack (TV CDP + warm snapshot + dashboard): double-click `Launch-Everything.cmd`
# Dashboard only: `Start-Advisor-Dashboard.cmd`
#
# TradingView MCP — Chrome DevTools (Desktop app only)
# Default bind is http://127.0.0.1:9222 (use 127.0.0.1 so Node/Chromium IPv4 resolves reliably).
# TRADINGVIEW_CDP_HOST=
# TRADINGVIEW_CDP_PORT=9222
# If installs are detected but tv_launch fails, set this to Task Manager → TradingView.exe → Open file location.
# TRADINGVIEW_EXECUTABLE=C:\Path\To\TradingView.exe
#
# Optional launcher env:
# LAUNCH_STACK_SKIP_TV=1   — do not run tv launch; fail if CDP is already down
# LAUNCH_STACK_NO_WARM=1   — skip initial quant-advisor run
#
# Copy to `.env` or `.env.local` (both are gitignored). Loaded automatically by:
#   npm run advisor
#   npm run advisor:ui
# `.env.local` overrides `.env` for the same key only if the variable is not already set in the environment.

# OpenAI — enables "Ask AI (stream)" in the advisor dashboard.
# After saving .env, restart the dashboard (close the console or stop npm run advisor:ui).
OPENAI_API_KEY=
ADVISOR_OPENAI_MODEL=gpt-4o-mini

# Optional: POST full advisor JSON after each `quant-advisor` run
ADVISOR_WEBHOOK_URL=

# Dashboard server (advisor-ui)
ADVISOR_UI_PORT=4890
ADVISOR_UI_HOST=127.0.0.1
# ADVISOR_UI_STRICT_PORT=1  — fail if ADVISOR_UI_PORT is busy (default: scan for next free port)

# Optional: custom JSONL path for run-to-run memory
# ADVISOR_MEMORY=data/advisor-memory.jsonl

# Advisor drawdown alignment (quant-advisor / llm_brief) — optional
# Must match strategy() initial_capital when converting DD % → $
# ADVISOR_INITIAL_CAPITAL=100000
# If set, fires priority DD_CAP when estimated tester max DD $ exceeds this (grid: GRID_MAX_DD_USD)
# ADVISOR_MAX_DD_USD=2000

# Pin which Pine strategy to read when multiple strategies are on the chart (substring of strategy() title in TV).
# Default in code: Sweep (matches Strategy Tester label "Sweep v2" and Pine titles). Override here or set ADVISOR_STRATEGY_SUBSTRING= to disable substring filtering.
# ADVISOR_STRATEGY_SUBSTRING=Sweep v2
# Secondary sandbox copy (sweep-engine-v2-secondary.pine): pin reads to this strategy when both are on chart
# ADVISOR_STRATEGY_SUBSTRING=Secondary
# (alias) TV_STRATEGY_NAME=

# Warn when total trades in report below this (0 = off)
# ADVISOR_MIN_TRADES=15

# HIGH_DD_PCT flag when tester DD% exceeds this (0 = off)
# ADVISOR_WARN_DD_PCT=5

# winrate-grid.mjs — hard-reject parameter combos (0 = off). See scripts/winrate-grid.mjs header.
# GRID_MAX_DD_PCT=2.5
# GRID_MAX_DD_USD=2000
# GRID_INITIAL_CAPITAL=100000

# npm run grid:dd — runs winrate-grid with net_dd + defaults (override env as needed)
